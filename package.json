{
  "name": "vinilhero",
  "productName": "VinilHero",
  "version": "0.3.0",
  "description": "Simulador de loja de discos que se move com a sua performance no Fretshift",
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "electron .",
    "test": "eslint . && node --test",
    "lint": "eslint .",
    "simular": "node src/cli/simular.js",
    "dist": "electron-builder --win --publish never",
    "icone": "node scripts/icone.js"
  },
  "author": "LCavarcan",
  "license": "MIT",
  "allowScripts": {
    "electron@44.7.2": true
  },
  "dependencies": {
    "@azure/msal-node": "7.1.1",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "com.lcavarcan.vinilhero",
    "productName": "VinilHero",
    "files": [
      "src/**/*",
      "package.json",
      "!src/cli/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VinilHero-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LCavarcan",
        "repo": "VinilHero",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LCavarcan/VinilHero.git"
  }
}
